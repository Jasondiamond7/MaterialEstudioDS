            "PC2    1.0666          0.2667     0.5437\n",
            "PC3    0.9354          0.2338     0.7775\n",
            "PC4    0.8900          0.2225     1.0000\n",
            "PC1 + PC2 = 0.5437\n",
            "\n",
            "Cargas:\n",
            "                      PC1     PC2     PC3     PC4\n",
            "edad               0.5783 -0.4254 -0.3362  0.6095\n",
            "saldo              0.6298 -0.3080  0.3865 -0.5993\n",
            "contactos_campana -0.3812 -0.5792  0.6480  0.3150\n",
            "contactos_previos  0.3515  0.6234  0.5636  0.4125\n",
            "\n",
            "Correlaciones entre las 4 variables:\n",
            "                    edad  saldo  contactos_campana  contactos_previos\n",
            "edad               1.000  0.097             -0.014             -0.011\n",
            "saldo              0.097  1.000             -0.009              0.024\n",
