        "        aj, va = pliegues != f, pliegues == f\n",
        "        prep = ColumnTransformer([('num', 'passthrough', NUM), ('bin', 'passthrough', BIN),\n",
        "                                  ('cat', OneHotEncoder(drop='first', handle_unknown='ignore', sparse_output=False), CAT)]).fit(datos[aj])\n",
